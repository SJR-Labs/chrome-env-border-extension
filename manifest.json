{
  "manifest_version": 3,
  "name": "Environment Border Highlighter (Enterprise)",
  "version": "2.0",
  "description": "Environment highlighter with strict matching and validation",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
